import React from 'react';
import {AbsoluteFill,Composition,Img,OffthreadVideo,Sequence,Audio,interpolate,spring,staticFile,useCurrentFrame,registerRoot} from 'remotion';
const files=['1-aerial-arrival.jpg','2-pool-hero.jpg','3-living-room.jpg','4-stair-detail.jpg','5-terrace-finale.jpg'];
const clamp={extrapolateLeft:'clamp',extrapolateRight:'clamp'} as const;
const lerp=(f:number,a:number,b:number,x=0,y=1)=>interpolate(f,[a,b],[x,y],clamp);
const ink='#20352d',lime='#d4f775';
function Film(){
 const f=useCurrentFrame();
 const reveal=spring({frame:f-195,fps:30,config:{damping:22,stiffness:85}});
 const bw=620+(848-620)*reveal,bh=350+(1060-350)*reveal;
 const bx=(1080-bw)/2,by=655+(257-655)*reveal;
 const done=files.filter((_,i)=>f>=76+i*19+25).length;
 return <AbsoluteFill style={{background:'#f6f5ef',color:ink,fontFamily:'Arial, sans-serif',overflow:'hidden'}}>
  <AbsoluteFill style={{backgroundImage:'radial-gradient(#20352d18 1.5px, transparent 1.5px)',backgroundSize:'30px 30px',opacity:.35}}/>
  <div style={{position:'absolute',width:800,height:800,left:140,top:480,borderRadius:'50%',background:'#def0bd',filter:'blur(110px)',opacity:.48}}/>
  <div style={{position:'absolute',left:70,top:52,fontSize:43,fontWeight:800,letterSpacing:-2}}>homie<span style={{color:'#8aac3e'}}>.</span></div>
  <div style={{position:'absolute',right:70,top:62,fontSize:18,letterSpacing:3}}>PHOTOS → WALKTHROUGH</div>
  <div style={{position:'absolute',top:155-20*reveal,width:'100%',textAlign:'center',opacity:1-reveal,transform:`translateY(${lerp(f,0,24,25,0)}px)`}}>
   <div style={{fontSize:87,lineHeight:1.02,fontWeight:800,letterSpacing:-5}}>Drop your photos.</div>
   <div style={{fontSize:87,lineHeight:1.12,fontWeight:800,letterSpacing:-5,color:'#708e43'}}>We'll make the moves.</div>
  </div>
  <div style={{position:'absolute',top:147,width:'100%',textAlign:'center',fontSize:66,fontWeight:800,letterSpacing:-3,opacity:reveal}}>Your home. In motion.</div>
  <div style={{position:'absolute',left:bx,top:by,width:bw,height:bh,borderRadius:38,background:'#fff',boxShadow:'0 28px 80px #1c382424',transform:`scale(${1+Math.sin(f*.2)*.007*(f>75&&f<180?1:0)})`,overflow:'hidden',border:'2px solid #20352d14'}}>
   <div style={{position:'absolute',inset:20,border:'3px dashed #a3b788',borderRadius:24,opacity:1-reveal}}/>
   <div style={{position:'absolute',inset:0,display:'flex',alignItems:'center',justifyContent:'center',flexDirection:'column',opacity:f<168?1:1-lerp(f,185,198)}}>
    <div style={{width:82,height:82,borderRadius:24,background:lime,display:'grid',placeItems:'center',fontSize:53,marginBottom:22}}>{f<168?'↓':'✦'}</div>
    <div style={{fontSize:32,fontWeight:700}}>{f<168?'Drop photos here':'Creating your walkthrough'}</div>
    <div style={{fontSize:20,marginTop:13,color:'#7e887d'}}>{f<168?`${done} of 5 photos added`:'Connecting every space…'}</div>
    {f>=168&&<div style={{width:400,height:5,background:'#e8edde',marginTop:24,borderRadius:8,overflow:'hidden'}}><div style={{width:`${lerp(f,168,194)*100}%`,height:'100%',background:ink}}/></div>}
   </div>
   {f>=195&&<Sequence from={195}><OffthreadVideo muted src={staticFile('assets/tour-fast.mp4')} style={{width:'100%',height:'100%',objectFit:'cover',opacity:reveal}}/></Sequence>}
   {f>=195&&<div style={{position:'absolute',bottom:0,left:0,right:0,padding:'90px 35px 30px',background:'linear-gradient(transparent,#12281cbf)',color:'white',opacity:reveal}}><div style={{fontSize:14,letterSpacing:3,marginBottom:10}}>GOLDEN HOUR ESTATE</div><div style={{fontSize:34,fontWeight:600}}>Welcome to your next chapter.</div><div style={{height:3,marginTop:25,background:'#ffffff50'}}><div style={{height:3,background:lime,width:`${lerp(f,195,538)*100}%`}}/></div></div>}
  </div>
  {files.map((file,i)=>{
   const entrance=spring({frame:f-i*5-10,fps:30,config:{damping:15,stiffness:100}});
   const toss=lerp(f,76+i*19,101+i*19);
   const x0=[85,375,730,180,610][i],y0=[440,390,470,1050,1060][i];
   const x=x0+(460-x0)*toss,y=y0+(785-y0)*toss-210*Math.sin(toss*Math.PI);
   const rot=[-13,5,14,-9,11][i]*(1-toss)+toss*24;
   return toss>=1?null:<div key={file} style={{position:'absolute',left:x,top:y,width:220,height:270,padding:10,background:'white',borderRadius:18,boxShadow:'0 14px 28px #19312426',opacity:entrance*(1-lerp(toss,.8,1)),transform:`translateY(${(1-entrance)*100}px) rotate(${rot}deg) scale(${(1-toss*.78)*entrance})`}}><Img src={staticFile('assets/'+file)} style={{width:'100%',height:220,objectFit:'cover',borderRadius:11}}/><div style={{paddingTop:11,fontSize:13,letterSpacing:2,color:'#7b8578'}}>0{i+1} / {['ARRIVAL','POOL','LIVING','DETAILS','TERRACE'][i]}</div></div>
  })}
  <div style={{position:'absolute',bottom:50,left:0,width:'100%',textAlign:'center',fontSize:22,color:'#6b7c6d',opacity:1-reveal}}>Five photos. One seamless story.</div>
  <div style={{position:'absolute',bottom:48,left:0,width:'100%',textAlign:'center',fontSize:23,fontWeight:600,opacity:reveal}}>Drop. Generate. <span style={{background:lime,borderRadius:30,padding:'10px 22px',marginLeft:8}}>Walk through.</span></div>
  <Audio src={staticFile('assets/sound.wav')} volume={.65}/>
 </AbsoluteFill>
}
registerRoot(()=> <Composition id="HomieDrop" component={Film} durationInFrames={540} fps={30} width={1080} height={1440}/>);
