SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
# Primary video engine. Set to higgsfield to use the existing CLI integration.
VIDEO_PROVIDER=runway
RUNWAYML_API_SECRET=key_49914746300e2b18f851935690f91858f69728adc62827e573fccc1c407cacf44b963798a4996ad8468b2e6db632e73f23c3b4e882bcdcfa4c05611665038775
# gen4.5 is slower and more expensive, but preserves architectural detail better.
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_POLL_MS=5000
RUNWAY_WAIT_TIMEOUT_MS=1800000
HIGGSFIELD_VIDEO_MODEL=seedance_2_0
HIGGSFIELD_VIDEO_RESOLUTION=720p
HIGGSFIELD_WAIT_TIMEOUT=30m
VIDEO_WORKER_POLL_MS=5000
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=homie
# Optional for local development: also seed Wrangler's local R2 so localhost can play the result.
R2_SEED_LOCAL=1
