SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
# Higgsfield is the exclusive video-generation engine. Authenticate this
# server-side worker once with `higgsfield auth login`.
HIGGSFIELD_VIDEO_MODEL=seedance_2_0
HIGGSFIELD_VIDEO_RESOLUTION=720p
HIGGSFIELD_WAIT_TIMEOUT=30m
VIDEO_WORKER_POLL_MS=5000
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=homie
# Optional for local development: also seed Wrangler's local R2 so localhost can play the result.
R2_SEED_LOCAL=1

# Kling direct API key (server-side only). Configure before activating Kling templates.
# Create these in the Kling developer API console. Never use NEXT_PUBLIC_ prefixes.
KLING_API_KEY=your-kling-api-key
KLING_API_BASE_URL=https://api-singapore.klingai.com

# Public Higgsfield API credentials (server only).
HF_API_KEY_ID=
HF_API_KEY_SECRET=
