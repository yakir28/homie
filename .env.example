NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-side Supabase key used only by trusted billing webhooks.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Polar billing (server-side only). Start with sandbox, then switch to production.
POLAR_ACCESS_TOKEN=polar_oat_your-organization-access-token
POLAR_WEBHOOK_SECRET=polar_whs_your-webhook-secret
POLAR_SERVER=sandbox
POLAR_PRODUCT_STARTER=your-starter-product-id
POLAR_PRODUCT_PRO=your-pro-product-id
POLAR_PRODUCT_BUSINESS=your-business-product-id
POLAR_PRODUCT_STARTER_ANNUAL=your-annual-starter-product-id
POLAR_PRODUCT_PRO_ANNUAL=your-annual-pro-product-id
POLAR_PRODUCT_BUSINESS_ANNUAL=your-annual-business-product-id

# Sandbox uses separate credentials and product IDs; no live fallback.
POLAR_SANDBOX_ACCESS_TOKEN=your-sandbox-organization-access-token
POLAR_SANDBOX_WEBHOOK_SECRET=your-sandbox-webhook-secret
POLAR_SANDBOX_PRODUCT_STARTER=your-sandbox-starter-product-id
POLAR_SANDBOX_PRODUCT_PRO=your-sandbox-pro-product-id
POLAR_SANDBOX_PRODUCT_BUSINESS=your-sandbox-business-product-id
POLAR_SANDBOX_PRODUCT_STARTER_ANNUAL=your-sandbox-annual-starter-product-id
POLAR_SANDBOX_PRODUCT_PRO_ANNUAL=your-sandbox-annual-pro-product-id
POLAR_SANDBOX_PRODUCT_BUSINESS_ANNUAL=your-sandbox-annual-business-product-id

# Canonical deployed app origin, without a trailing slash.
APP_URL=https://your-homie-domain.example

# HasData Zillow scraper (server-side only)
HASDATA_API_KEY=your-hasdata-api-key

# Cloudflare R2 (server-side only; used by the video worker and asset sync)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=homie
MEDIA_SIGNING_SECRET=replace-with-a-long-random-server-only-secret

# Public R2 custom domain used for immutable template assets, without a trailing slash.
# Leave blank locally to keep using /api/media/template.
NEXT_PUBLIC_MEDIA_ORIGIN=https://media.example.com

# Enable after Cloudflare Images transformations are enabled for the website zone.
NEXT_PUBLIC_IMAGE_TRANSFORMATIONS=1

# Random secret used by the website to create short-lived private playback URLs
# MEDIA_SIGNING_SECRET is declared above.

# Server-only Director conversation credentials (never NEXT_PUBLIC_).
OPENAI_API_KEY=your-openai-api-key
OPENAI_DIRECTOR_MODEL=gpt-4.1-mini

# Enable only after add_polar_credit_purchases is applied to this environment.
POLAR_CREDIT_PURCHASES_ENABLED=false
POLAR_PRODUCT_CREDITS_60=your-live-60-credit-product
POLAR_PRODUCT_CREDITS_150=your-live-150-credit-product
POLAR_PRODUCT_CREDITS_300=your-live-300-credit-product
POLAR_PRODUCT_CREDITS_600=your-live-600-credit-product
POLAR_SANDBOX_PRODUCT_CREDITS_60=your-sandbox-60-credit-product
POLAR_SANDBOX_PRODUCT_CREDITS_150=your-sandbox-150-credit-product
POLAR_SANDBOX_PRODUCT_CREDITS_300=your-sandbox-300-credit-product
POLAR_SANDBOX_PRODUCT_CREDITS_600=your-sandbox-600-credit-product

# $1 first-video offer; enable only after paid_first_video migration and products.
POLAR_FIRST_VIDEO_ENABLED=false
POLAR_PRODUCT_FIRST_VIDEO=your-live-one-dollar-product
POLAR_SANDBOX_PRODUCT_FIRST_VIDEO=your-sandbox-one-dollar-product

# Post-intro pack: 90 credits for $20, after a paid first video completes.
POLAR_PRODUCT_CREDITS_90=your-live-90-credit-product
POLAR_SANDBOX_PRODUCT_CREDITS_90=your-sandbox-90-credit-product
