NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# HasData Zillow scraper (server-side only)
HASDATA_API_KEY=your-hasdata-api-key

# Cloudflare R2 (server-side only; used by the video worker and asset sync)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=homie
MEDIA_SIGNING_SECRET=replace-with-a-long-random-server-only-secret

# Random secret used by the website to create short-lived private playback URLs
MEDIA_SIGNING_SECRET=generate-a-long-random-secret
