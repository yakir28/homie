{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://site-creator-vinext-starter.homie-support.workers.dev/"
    },
    {
      "source": "/:path*",
      "destination": "https://site-creator-vinext-starter.homie-support.workers.dev/:path*"
    }
  ]
}
