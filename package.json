{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "video:worker": "node --env-file-if-exists=video-worker.env scripts/video-worker.mjs --higgsfield-api-only",
    "video:worker:once": "node --env-file-if-exists=video-worker.env scripts/video-worker.mjs --once --higgsfield-api-only",
    "video:worker:dry-run": "node --env-file-if-exists=video-worker.env scripts/video-worker.mjs --once --dry-run --higgsfield-api-only",
    "r2:sync-templates": "node scripts/sync-templates-to-r2.mjs",
    "video:audit": "node --env-file-if-exists=video-worker.env scripts/audit-video-templates.mjs",
    "test:video": "node --test tests/video-pipeline.test.mjs tests/prompt-video.test.mjs tests/director-chat.test.mjs tests/kling.test.mjs tests/higgsfield-api.test.mjs tests/higgsfield-reference.test.mjs",
    "video:kling:check": "node --env-file-if-exists=video-worker.env scripts/check-kling.mjs",
    "video:audit:kling": "node --env-file-if-exists=video-worker.env scripts/audit-video-templates.mjs --kling",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types worker-configuration.d.ts --config dist/server/wrangler.json --include-env false",
    "video:higgsfield:check": "node --env-file-if-exists=video-worker.env scripts/check-higgsfield.mjs",
    "video:worker:higgsfield": "node --env-file-if-exists=video-worker.env scripts/video-worker.mjs --higgsfield-api-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.112.2",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "standardwebhooks": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
